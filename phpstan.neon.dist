parameters:
    level: 8
    paths:
        - src
        # The example corpus is type-checked so a wrong request-building type (a
        # model where a request type is wanted) fails at author time, not on the
        # wire — the same guard the TS SDK gets from compiling its examples.
        - examples
    excludePaths:
        # Generated wire layer (jane-php). Never hand-edited, not our style bar.
        - src/Wire
    scanFiles:
        # WordPress ships no Composer autoloader, so its symbols (used only by the
        # examples/php/wordpress.php integration example) come from the stubs.
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
