parameters:
    level: 8
    # Every other tool here caches inside the package. PHPStan alone defaults to
    # the shared system temp, so parallel worktrees poison each other's cache with
    # phar paths into a `vendor/` that is not theirs, and it fails as an internal
    # error about a missing stub rather than as a cache problem.
    tmpDir: .phpstan.cache
    paths:
        - src
        # The example corpus is type-checked so a wrong request-building type (a
        # model where a request type is wanted) fails at author time, not on the
        # wire — the same guard the TS SDK gets from compiling its examples.
        - examples
    excludePaths:
        # Generated wire layer (jane-php). Never hand-edited, not our style bar.
        - src/Wire
    scanFiles:
        # WordPress ships no Composer autoloader, so its symbols (used only by the
        # examples/php/wordpress.php integration example) come from the stubs.
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
