{
    "name": "messagebird/sdk",
    "description": "The official PHP SDK for the Bird API: email, SMS, WhatsApp, verification, and Realtime on one typed client.",
    "type": "library",
    "license": "MIT",
    "keywords": ["bird", "api", "sdk", "email", "sms", "whatsapp", "verify", "realtime", "webhooks"],
    "homepage": "https://bird.com",
    "authors": [{ "name": "Bird" }],
    "support": {
        "docs": "https://bird.com/docs/sdks/php",
        "issues": "https://github.com/messagebird/bird-sdk-php/issues",
        "source": "https://github.com/messagebird/bird-sdk-php"
    },
    "require": {
        "php": ">=8.2",
        "jane-php/json-schema-runtime": "^7.12",
        "nyholm/psr7": "^1.8",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "standard-webhooks/standard-webhooks": "^1.0",
        "symfony/http-client": "^7.0 || ^8.0",
        "symfony/serializer": "^7.0 || ^8.0"
    },
    "suggest": {
        "ext-sodium": "Required to publish to Realtime private-encrypted- channels (XSalsa20-Poly1305 sealing). Bundled with PHP 8.2+, but some builds disable it."
    },
    "require-dev": {
        "jane-php/open-api-3": "^7.12",
        "guzzlehttp/guzzle": "^7.8",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "illuminate/http": "^11.0 || ^12.0",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/routing": "^7.0 || ^8.0",
        "php-stubs/wordpress-stubs": "^6.4"
    },
    "autoload": {
        "psr-4": { "MessageBird\\": "src/" },
        "classmap": ["src/Resources/"]
    },
    "autoload-dev": {
        "psr-4": { "MessageBird\\Tests\\": "tests/" }
    },
    "config": {
        "allow-plugins": { "php-http/discovery": true },
        "platform": { "php": "8.2.0" },
        "sort-packages": true
    },
    "scripts": {
        "generate": "scripts/generate.sh",
        "lint": "php-cs-fixer fix --dry-run --diff --allow-unsupported-php-version=yes",
        "fmt": "php-cs-fixer fix --allow-unsupported-php-version=yes",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    }
}
