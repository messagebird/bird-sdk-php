<?php

// Wire-layer generation config for jane-php (models + normalizers only).
// The generate pipeline (scripts/generate.sh) feeds jane the 3.0-compat bundle
// and strips everything except Model/, Normalizer/, and Runtime/Normalizer/.
//
// `whitelisted-paths` is the operation filter: the surfacegen-emitted KEEP list
// (scripts/surface-paths.php, the analog of clients/sdk-python/scripts/surface_ops.py),
// regenerated from backend/surfaces/surfaces.yaml. Never hand-edit that list.

return [
    'openapi-file' => __DIR__ . '/.generated/openapi.public.compat.yaml',
    'namespace' => 'MessageBird\\Wire',
    // generate.sh sets BIRD_PHP_WIRE_OUT to beak's stage path so a beak run
    // writes into the stage, not the committed tree (see that script).
    'directory' => getenv('BIRD_PHP_WIRE_OUT') ?: __DIR__ . '/src/Wire',
    'reference' => true,
    'strict' => false,
    'use-fixer' => false,
    'whitelisted-paths' => require __DIR__ . '/scripts/surface-paths.php',
];
